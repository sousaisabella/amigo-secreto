{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.length >= 6 && $room.length <= 40 && $room.matches(/^[0-9a-f]+$/)",
        ".write": "$room.length >= 6 && $room.length <= 40 && $room.matches(/^[0-9a-f]+$/) && newData.exists()",
        "meta": {
          "v": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "t": { ".validate": "newData.isString() && newData.val().length <= 50" },
          "round": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "cyc": { ".validate": "newData.isBoolean()" },
          "rv": { ".validate": "newData.isBoolean()" },
          "oh": {
            ".validate": "newData.hasChildren(['s', 'h'])",
            "s": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "h": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "$other": { ".validate": false }
          },
          "drawn": {
            "at": { ".validate": "newData.isNumber()" },
            "ids": { "$p": { ".validate": "newData.isBoolean()" } },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "people": {
          "$p": {
            ".validate": "$p.length <= 40 && newData.hasChild('n')",
            "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "w": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "pk": { ".validate": "newData.isString() && newData.val().length <= 140" },
            "h": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "l": {
              "$i": {
                ".validate": "newData.hasChildren(['t', 'u'])",
                "t": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "u": { ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().matches(/^https?:\\/\\//)" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "keys": {
          "$p": {
            ".validate": "newData.hasChildren(['s', 'i', 'c'])",
            "s": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "i": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "c": { ".validate": "newData.isString() && newData.val().length <= 1200" },
            "$other": { ".validate": false }
          }
        },
        "res": {
          "$p": {
            ".validate": "newData.hasChildren(['e', 'i', 'c'])",
            "e": { ".validate": "newData.isString() && newData.val().length <= 140" },
            "i": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "c": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "$other": { ".validate": false }
          }
        },
        "ex": { "$p": { "$q": { ".validate": "newData.isBoolean()" } } },
        "d": { "$k": { ".validate": "newData.hasChild('t')", "t": { ".validate": "newData.isString() && newData.val().length <= 60" }, "by": { ".validate": "newData.isString() && newData.val().length <= 40" }, "$other": { ".validate": false } } },
        "p": { "$k": { ".validate": "newData.hasChild('t')", "t": { ".validate": "newData.isString() && newData.val().length <= 60" }, "by": { ".validate": "newData.isString() && newData.val().length <= 40" }, "$other": { ".validate": false } } },
        "f": { "$k": { ".validate": "newData.hasChild('t')", "t": { ".validate": "newData.isString() && newData.val().length <= 60" }, "by": { ".validate": "newData.isString() && newData.val().length <= 40" }, "$other": { ".validate": false } } },
        "votes": { "$key": { "$o": { "$p": { ".validate": "newData.isBoolean()" } } } },
        "qa": {
          "$q": {
            ".validate": "newData.hasChildren(['to', 'q'])",
            "to": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "q": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140" },
            "a": { ".validate": "newData.isString() && newData.val().length <= 140" },
            "$other": { ".validate": false }
          }
        },
        "rev": { "$p": { ".validate": "newData.isString() && newData.val().length <= 40" } },
        "$other": { ".validate": false }
      }
    }
  }
}
