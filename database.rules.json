{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "rooms": {
          "$room": {
            ".validate": "$room.length >= 6 && $room.length <= 40",
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 50"
            },
            "org": {
              ".validate": "newData.isBoolean()"
            },
            "sk": {
              ".validate": "newData.hasChildren(['kty', 'crv', 'x', 'y', 'd'])",
              "kty": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 10"
              },
              "crv": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 10"
              },
              "x": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 64"
              },
              "y": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 64"
              },
              "d": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 64"
              },
              "ext": {
                ".validate": "newData.isBoolean()"
              },
              "key_ops": {
                "$i": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 20"
                }
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.length >= 6 && $room.length <= 40 && $room.matches(/^[0-9a-f]+$/)",
        ".write": "auth != null && !newData.exists() && data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".write": "auth != null && $room.length >= 6 && $room.length <= 40 && $room.matches(/^[0-9a-f]+$/) && ((!data.exists() && newData.child('owner').val() === auth.uid && auth.token.firebase.sign_in_provider !== 'anonymous') || (data.child('owner').val() === auth.uid && newData.child('owner').val() === auth.uid))",
          "owner": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('rooms').child($room).child('meta').exists()",
            ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())"
          },
          "v": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 50"
          },
          "round": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 16"
          },
          "cyc": {
            ".validate": "newData.isBoolean()"
          },
          "rv": {
            ".validate": "newData.isBoolean()"
          },
          "drawn": {
            "at": {
              ".validate": "newData.isNumber()"
            },
            "ids": {
              "$p": {
                ".validate": "newData.isBoolean()"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "oh": {
            ".validate": false
          },
          "pl": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{22}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "people": {
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($room).child('meta/owner').exists() && (auth.uid === $uid || (!newData.exists() && (root.child('rooms').child($room).child('meta/owner').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['n', 'pk'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "w": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
            },
            "pk": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 140"
            },
            "l": {
              "$i": {
                ".validate": "newData.hasChildren(['t', 'u'])",
                "t": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 60"
                },
                "u": {
                  ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().matches(/^https?:\\/\\//)"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "res": {
          ".write": "auth != null && (root.child('rooms').child($room).child('meta/owner').val() === auth.uid)",
          "$p": {
            ".write": "auth != null && auth.uid === $p && !newData.exists()",
            ".validate": "newData.hasChildren(['e', 'i', 'c'])",
            "e": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 140"
            },
            "i": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 32"
            },
            "c": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 400"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ex": {
          ".write": "auth != null && (root.child('rooms').child($room).child('meta/owner').val() === auth.uid)",
          "$p": {
            ".write": "auth != null && auth.uid === $p && !newData.exists()",
            "$q": {
              ".write": "auth != null && auth.uid === $q && !newData.exists()",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "d": {
          "$k": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms').child($room).child('people').child(auth.uid).exists() && newData.child('u').val() === auth.uid) || (!newData.exists() && (data.child('u').val() === auth.uid || (root.child('rooms').child($room).child('meta/owner').val() === auth.uid))))",
            ".validate": "newData.hasChildren(['t', 'u'])",
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
            },
            "u": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "p": {
          "$k": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms').child($room).child('people').child(auth.uid).exists() && newData.child('u').val() === auth.uid) || (!newData.exists() && (data.child('u').val() === auth.uid || (root.child('rooms').child($room).child('meta/owner').val() === auth.uid))))",
            ".validate": "newData.hasChildren(['t', 'u'])",
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
            },
            "u": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "f": {
          "$k": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms').child($room).child('people').child(auth.uid).exists() && newData.child('u').val() === auth.uid) || (!newData.exists() && (data.child('u').val() === auth.uid || (root.child('rooms').child($room).child('meta/owner').val() === auth.uid))))",
            ".validate": "newData.hasChildren(['t', 'u'])",
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
            },
            "u": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 128"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "votes": {
          "$key": {
            "$o": {
              ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('meta/owner').val() === auth.uid)",
              "$p": {
                ".write": "auth != null && ((auth.uid === $p && root.child('rooms').child($room).child('people').child(auth.uid).exists()) || (!newData.exists() && (root.child('rooms').child($room).child('meta/owner').val() === auth.uid)))",
                ".validate": "newData.val() === true && root.child('rooms').child($room).child($key).child($o).exists()"
              }
            }
          }
        },
        "qa": {
          "$q": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms').child($room).child('people').child(auth.uid).exists() && !newData.child('a').exists()) || (!newData.exists() && ((root.child('rooms').child($room).child('meta/owner').val() === auth.uid) || data.child('to').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['to', 'q'])",
            "to": {
              ".validate": "newData.isString() && root.child('rooms').child($room).child('people').child(newData.val()).exists() && (!data.exists() || data.val() === newData.val())"
            },
            "q": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140 && (!data.exists() || data.val() === newData.val())"
            },
            "a": {
              ".write": "auth != null && !data.exists() && root.child('rooms').child($room).child('qa').child($q).child('to').val() === auth.uid",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "rev": {
          ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('meta/owner').val() === auth.uid)",
          "$p": {
            ".write": "auth != null && (auth.uid === $p || (!newData.exists() && (root.child('rooms').child($room).child('meta/owner').val() === auth.uid)))",
            ".validate": "newData.isString() && root.child('rooms').child($room).child('people').child(newData.val()).exists()"
          }
        },
        "keys": {
          ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('meta/owner').val() === auth.uid)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
